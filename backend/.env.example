# Copiar a ".env" en este mismo directorio y ajustar los valores.
# El archivo ".env" real NUNCA se sube al repositorio (ver .gitignore).
# No incluir secretos, tokens ni contraseñas reales en git.

# --- PostgreSQL ---
POSTGRES_DB=practica5
POSTGRES_USER=practica5_user
POSTGRES_PASSWORD=cambia_esta_contrasena

# --- Backend / JWT ---
# Cadena larga y aleatoria:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_y_largo
JWT_EXPIRE_MINUTES=1440

# --- Google Sign-In ---
# Client IDs PUBLICOS (no son secretos), separados por coma. Incluir el web,
# el de Android y el de iOS: el backend acepta el "aud" que corresponda.
GOOGLE_CLIENT_IDS=tu-web-client-id.apps.googleusercontent.com

# --- Cuenta administrador (para app.bootstrap_admin) ---
ADMIN_EMAIL=admin@biblioteca.test
ADMIN_PASSWORD=cambia_esta_contrasena_de_admin
ADMIN_NAME=Administrador ESCOM
